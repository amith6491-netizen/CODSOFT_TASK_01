generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum FeeStatus {
  PENDING
  PAID
  OVERDUE
  WAIVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student Student?
  teacher Teacher?
}

model Teacher {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId String   @unique
  subject    String
  phone      String?
  createdAt  DateTime @default(now())

  classes         ClassSection[] @relation("ClassTeacher")
  examsCreated    Exam[]
  attendanceTaken Attendance[]
}

model Student {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  admissionNo   String   @unique
  dateOfBirth   DateTime?
  guardianName  String?
  guardianPhone String?
  classId       String?
  class         ClassSection? @relation(fields: [classId], references: [id])
  createdAt     DateTime @default(now())

  attendance Attendance[]
  grades     Grade[]
  fees       Fee[]
}

model ClassSection {
  id        String  @id @default(cuid())
  name      String // e.g. "Grade 10 - A"
  gradeYear Int
  teacherId String?
  teacher   Teacher? @relation("ClassTeacher", fields: [teacherId], references: [id])

  students Student[]
  exams    Exam[]

  @@unique([name, gradeYear])
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime
  status    AttendanceStatus
  takenById String
  takenBy   Teacher          @relation(fields: [takenById], references: [id])
  createdAt DateTime         @default(now())

  @@unique([studentId, date])
}

model Exam {
  id          String   @id @default(cuid())
  title       String
  subject     String
  classId     String
  class       ClassSection @relation(fields: [classId], references: [id])
  date        DateTime
  maxMarks    Int
  createdById String
  createdBy   Teacher  @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  grades Grade[]
}

model Grade {
  id            String   @id @default(cuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  marksObtained Float
  remarks       String?
  createdAt     DateTime @default(now())

  @@unique([examId, studentId])
}

model Fee {
  id        String    @id @default(cuid())
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term      String // e.g. "2026 Term 1"
  amount    Float
  dueDate   DateTime
  status    FeeStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime  @default(now())
}
